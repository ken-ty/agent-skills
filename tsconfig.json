{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Node strips types at runtime without type-checking. erasableSyntaxOnly bans
    // syntax that would need real emit (enum, namespace, parameter properties),
    // so anything tsc accepts is guaranteed to run under `node scripts/foo.ts`.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts"]
}
