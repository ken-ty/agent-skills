#!/bin/sh
#
# Block commits that carry secrets or machine-specific data, or that would
# leave the store describing itself wrongly.
#
# This is the template the `agent-skills` CLI installs into a store's hooks/
# dir. It is active only where `git config core.hooksPath hooks` has been set —
# done by `agent-skills link`, verified by `agent-skills doctor`. Hooks live in
# the store repo rather than .git/hooks so they are version-controlled.
#
# It delegates to the installed `agent-skills` command. Both subcommands act on
# the git repo they are invoked in (this store, or a worktree of it), not on
# whatever store this machine has configured.
#
# Only the `agent-skills` name is tried. The installers always create the
# `skill` alias alongside it, so `skill` alone never means a working install —
# and on Linux, procps ships /usr/bin/skill (a kill(1) variant), so falling back
# to it would signal processes named "audit" instead of auditing anything.
#
#   audit        secrets and machine-specific data in the staged content
#   doctor --repo   catalog / skills.lock / skill bodies still agree
#   pre-commit.d/*  the store's own checks (see below)
#
# audit runs first: a leaked secret is the worse outcome, and `set -e` means a
# hit there stops the commit before the second check adds noise.
#
# `git commit --no-verify` bypasses this. That is git's design, not an
# oversight: this hook is a backstop against mistakes, not a security boundary.
set -e
if ! command -v agent-skills >/dev/null 2>&1; then
  echo "pre-commit: agent-skills not on PATH — run the CLI's install.sh" >&2
  exit 1
fi

agent-skills audit

# Store-specific checks: every executable in hooks/pre-commit.d/, in name order.
# This file is a template that `link` overwrites, so a store's own checks (a
# generated file being stale, a frontmatter schema) cannot live here — they go
# in the drop-in directory, which link never touches. Each script runs from the
# repo root; a non-zero exit stops the commit, like the two built-ins.
top="$(git rev-parse --show-toplevel)"
if [ -d "$top/hooks/pre-commit.d" ]; then
  for check in "$top"/hooks/pre-commit.d/*; do
    [ -f "$check" ] && [ -x "$check" ] || continue
    (cd "$top" && "$check") || { echo "pre-commit: $(basename "$check") failed" >&2; exit 1; }
  done
fi

exec agent-skills doctor --repo
